{
    "name": "jeremykenedy/laravel-blocker",
    "description": "Manage blocked IP addresses, email addresses, domains, users, and locations in Laravel.",
    "keywords": [
        "laravel blocker",
        "laravel IP blocker",
        "laravel Email blocker",
        "Email blocker",
        "User blocker",
        "IP blocker",
        "Blocker"
    ],
    "license": "MIT",
    "type": "package",
    "authors": [
        {
            "name": "Jeremy Kenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "eklundkristoffer/seedster": "^7.0|^8.0|^9.0|^10.0",
        "spatie/laravel-html": "^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^3.8|^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^8.5|^9.6|^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\LaravelBlocker\\": "src/",
            "jeremykenedy\\LaravelBlocker\\Database\\Seeders\\": "src/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\LaravelBlocker\\LaravelBlockerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\LaravelBlocker\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/app/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php tools/lint.php"
    }
}
